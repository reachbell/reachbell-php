{
    "name": "reachbell/reachbell",
    "description": "ReachBell server SDK for PHP: transactional push, email, SMS and WhatsApp, events, subscribers, contacts and campaigns.",
    "type": "library",
    "license": "MIT",
    "keywords": ["reachbell", "push notifications", "web push", "transactional", "email", "sms", "whatsapp"],
    "homepage": "https://docs.reachbell.com/server/php",
    "authors": [{ "name": "DotSpheres Technologies Pvt Ltd" }],
    "support": { "issues": "https://github.com/reachbell/reachbell-php/issues", "source": "https://github.com/reachbell/reachbell-php" },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "ReachBell\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "ReachBell\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": { "sort-packages": true },
    "minimum-stability": "stable"
}
